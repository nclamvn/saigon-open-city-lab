geIntent","id":"1540522462","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1540522462","name":"VNPT SmartCA","impressionType":"lockup","idType":"its_id","platformDisplayStyle":"ios","impressionIndex":1,"contentRating":53,"bundleId":"com.vnpt.vnptkysoeidas"}}},{"$kind":"Lockup","adamId":"1501291334","bundleId":"com.vnedu.lms","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":1,"green":1,"blue":1,"type":"rgb"},"textColor":{"red":0.054901960784313725,"green":0.1568627450980392,"blue":0.2823529411764706,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/aa/fd/bd/aafdbddf-34c0-0c9b-588d-9cd1d4e3389a/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"vnEdu LMS","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Education","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"ageRating":"00+","productDescription":"Học tập chủ động và hiệu quả hơn với vnEdu LMS\nỨng dụng vnEdu LMS là công cụ hỗ trợ đắc lực cho nhà trường triển khai dạy và học trực tuyến một cách hiệu quả, bổ trợ cho công tác dạy và học trực tiếp trên lớp, góp phần đổi mới sáng tạo và chuyển đổi số phương thức dạy và học. \nỨng dụng cung cấp đầy đủ các chức năng của hệ thống quản lý học tập trực tuyến (LMS), được thiết kế khoa học, thân thiện.  Với vnEdu LMS, học sinh có thể:\n* Truy cập kho học liệu của các nhà trường với nhiều hình thức thể hiện đa dạng: Bài giảng lý thuyết, bài giảng video, bài giảng tương tác,... được chia theo các khối, môn,  giúp học sinh có thể dễ dàng nắm bắt, ôn lại các kiến thức mọi lúc mọi nơi\n* Thực hiện các nhiệm vụ, làm bài tập giáo viên giao, xem các thông báo của trường lớp, chủ động tương tác với giáo viên và bạn học\n* Tham gia các kỳ thi trực tuyến, xem kết quả, lời giải sau khi thi\n* Dễ dàng tải xuống các tài liệu phục vụ học tập  \n* Và nhiều tính năng hữu ích khác\nCác giải thưởng chúng tôi đạt được:\n* Giải vàng Asia - Pacific Stevie Award 2021\n* Giải thưởng Sản phẩm Công nghệ số Việt Nam Make in Viet Nam 2020\n* Giải thường về thu hẹp khoảng cách số Vietnam Digital Awards 2020\n* Danh hiệu Sao khuê 2019\nMọi thắc mắc, ý kiến đóng góp, yêu cầu hỗ trợ, vui lòng liên hệ đến hotline của chúng tôi 18001260 (Miễn phí)","rating":1.6,"ratingCount":"825","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1501291334&pricingParameters=STDQ&pg=borat_vnd&appExtVrsId=889229695"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"1501291334"},{"locationPosition":2,"locationType":"lockup","name":"vnEdu LMS","idType":"its_id","id":"1501291334"},{"locationPosition":5,"locationType":"swoosh","name":"More by Vietnam Posts and Telecommunications Group","idType":"sequential","id":"8"}],"jet_adamId":"1501291334","eventType":"click","targetType":"button","targetId":"1501291334","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1501291334"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1501291334","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=1501291334&pricingParameters=STDQ&pg=borat_vnd&appExtVrsId=889229695","vendor":"Vietnam Posts and Telecommunications Group","appName":"vnEdu LMS","bundleId":"com.vnedu.lms","appPlatforms":["phone","pad"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload":false,"preflightPackageUrl":n