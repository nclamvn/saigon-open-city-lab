CAD is 100% licensed and proudly developed in Vietnam, tailored to meet the needs of Vietnamese users. It is continuously updated with new features optimized for the construction and design industries.\nTo get started, simply log in to your account, upload your DWG drawings, and view or edit your files.\nExperience VinaCAD and make your design and drawing management faster, simpler, and more professional.","rating":3,"ratingCount":"13","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6753970013&pricingParameters=STDQ&pg=borat_vnd&appExtVrsId=890282862"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6753970013"},{"locationPosition":1,"locationType":"lockup","name":"VinaCAD - View & Edit DWG","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6753970013"},{"locationPosition":6,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"6753970013","eventType":"click","targetType":"button","targetId":"6753970013","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"6753970013"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"6753970013","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=6753970013&pricingParameters=STDQ&pg=borat_vnd&appExtVrsId=890282862","vendor":"skyace","appName":"VinaCAD - View & Edit DWG","bundleId":"com.vinacad.app","appPlatforms":["phone","pad"],"isPreorder":false,"exclu