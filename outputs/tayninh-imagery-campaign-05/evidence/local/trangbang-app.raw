ality":70,"supportsWideGamut":false}]},"title":"iLand BRVT","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Productivity","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"ageRating":"00+","productDescription":"Tính năng chính của phần mềm:\r\n- Người dùng có thể đăng nhập tài khoản Apple hoặc tài khoản khác để xem một số chức năng cơ bản\r\n- Tra cứu nhanh thông tin thửa đất gồm tờ, thửa, diện tích, loại đất, tình trạng cấp giấy chứng nhận quyền sử dụng đất, quy hoạch sử dụng đất\r\n- Định vị trí thửa đất trên bản đồ khi đi ra ngoài thực địa (chỉ xem thông tin được trên địa bàn tỉnh Bà Rịa - Vũng Tàu)\r\n- Tìm đường đi tới thửa đất trực tiếp trên iLand BRVT hoặc chuyển qua ứng dụng bản đồ khác\r\n- Tích hợp ảnh vệ tinh\r\n- Xem chi tiết thông tin quy hoạch sử dụng đất\r\n- Xem chi tiết thông tin lịch sử thửa đất\r\n- Xem thông tin tài sản gắn liền với thửa đất\r\n- Tìm kiếm thông tin thửa đất theo tên chủ sử dụng đối với tài khoản quản lý nhà nước\r\n- Cơ sở dữ liệu: được truy xuất trực tiếp đến cơ sở dữ liệu quản lý đất đai trên địa bàn toàn tỉnh Bà Rịa - Vũng Tàu thông qua Internet nên đảm bảo tính đồng bộ nguồn dữ liệu.\r\n- Và nhiều tính năng khác chúng tôi sẽ tiếp tục cập nhật","rating":4,"ratingCount":"20","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6478898625&pricingParameters=STDQ&pg=borat_vnd&appExtVrsId=871656245"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6478898625"},{"locationPosition":6,"locationType":"lockup","name":"iLand BRVT","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6478898625"},{"locationPosition":6,"locationTy