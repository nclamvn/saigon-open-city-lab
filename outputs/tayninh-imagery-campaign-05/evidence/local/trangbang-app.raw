,"title":"VNPT SmartCA","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Business","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"ageRating":"00+","productDescription":"VNPT SmartCA - ứng dụng ký số từ xa theo tiêu chuẩn châu Âu đến từ tập đoàn VNPT.\nVNPT SmartCA mang lại trải nghiệm ký số trọn vẹn chỉ trong một chiếc điện thoại với nhiều tính năng nổi bật, vượt trội, an toàn cao, hiệu quả cho khách hàng:\n\n- Đăng ký tài khoản trực tuyến sử dụng eKYC\n- Sở hữu không giới hạn, đặt tên và Ký số bằng nhiều Chứng thư trên cùng 01 thiết bị\n- Đăng ký chứng thư, lượt ký, Gia hạn, Thay đổi thông tin Chứng thư số trực tuyến\n- Ký số, Nhận file, Chia sẻ file ngay trên ứng dụng\n- Thay đổi thiết bị ký số nhanh chóng, tiện lợi\n- Theo dõi, thống kê toàn bộ giao dịch ký số\n","rating":2.6,"ratingCount":"1.1k","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1540522462&pricingParameters=STDQ&pg=borat_vnd&appExtVrsId=891003489"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"1540522462"},{"locationPosition":1,"locationType":"lockup","name":"VNPT SmartCA","idType":"its_id","id":"1540522462"},{"locationPosition":5,"locationType":"swoosh","name":"More by Vietnam Posts and Telecommunications Group","idType":"sequential","id":"8"}],"jet_adamId":"1540522462","eventType":"click","targetType":"button","targetId":"1540522462","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1540522462"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1540522462","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salabl