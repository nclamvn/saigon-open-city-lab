.apple.com/vn/developer/vietnam-posts-and-telecommunications-group/id1215567249","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","destination":{"storefront":"vn","language":"en-GB","id":"1215567249","$kind":"DeveloperPageIntent"}},"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":"More by Vietnam Posts and Telecommunications Group","titleArtwork":null,"subtitle":null,"isHorizontal":true,"isHidden":false,"rowsPerColumn":2,"background":{"type":"color","color":{"lightColor":{"red":0.9411764705882353,"green":0.9411764705882353,"blue":0.9725490196078431,"type":"rgb"},"darkColor":{"red":0.18823529411764706,"green":0.18823529411764706,"blue":0.19215686274509805,"type":"rgb"},"type":"dynamic"}},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"moreByDeveloper"},"similarItems":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"customers-also-bought-apps","name":"You Might Also Like","impressionType":"similarItems","idType":"relationship","impressionIndex":6}},"contentType":"smallLockup","marker":null,"items":[{"$kind":"Lockup","adamId":"6476085304","bundleId":"com.germlab.veso-mobile","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":1,"green":0.996078431372549,"blue":0.9764705882352941,"type":"rgb"},"textColor":{"red":0.10588235294117647,"green":0.1843137254901961,"blue":0.38823529411764707,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/7a/47/f8/7a47f87b-a8b3-7b6f-4863-cee0be91811f/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Veso - Ví vé số truyền thống","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Lifestyle","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"ageRating":"00+","productDescription":"Veso – Trợ thủ đắc lực cho người chơi xổ số kiến thiết Việt Nam!\n\n\r\nQuản lý vé số truyền thống chưa bao giờ dễ dàng đến thế. Ứng dụng giúp bạn:  \n\n\r\n- Lưu trữ thông minh.\n\nGhi lại vé số hằng ngày chỉ với vài thao tác.  \n\n\n\r\n- Theo dõi lịch sử.\n\nXem lại quá trình mua vé mọi lúc, mọi nơi.\n\n\n- Thống kê & phân tích\n\nCung cấp hiểu biết cá nhân hóa theo quá trình mua vé số của bạn.\n\n\r- Giao diện thân thiện, thao tác đơn giản, phù hợp cho mọi người chơi vé số\n\nBiến trải nghiệm truyền thống thành hiện đại\n\nTải ứng dụng Veso ngay hôm nay!\r\n\r","rating":5,"ratingCount":"1","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6476085304&pricingParameters=STDQ&pg=borat_vnd&appExtVrsId=886288938"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6476085304"},{"locationPosition":0,"locationType":"lockup","name":"Veso - Ví vé số truyền thống","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6476085304"},{"locationPosition":6,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"6476085304","eventType":"click","targetType":"button","targetId":"6476085304","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"6476085304"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"6476085304","purchaseConfiguration":{"$kind":"PurchaseConfigu