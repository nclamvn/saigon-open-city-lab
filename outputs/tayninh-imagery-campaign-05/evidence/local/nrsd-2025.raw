    </div>
    <div class="row">
        <div class="col-lg-12 " style="font-size: 25px; text-transform: uppercase; font-family: &quot; merriweather&quot; ,serif;">
            <p>Ý kiến</p>
        </div>
        <div class="col-lg-12 ">
            <textarea id="gop-y-tin-tuc" readonly placeholder="Chia sẻ ý kiến của bạn" style="overflow-y: hidden;"></textarea>
        </div>
        <div class="col-lg-12 ">
            <div class="zone-binh-luan">
                
            </div>
        </div>
    </div>
    <div class="modal " role="dialog" id="sendmail" style="width: 100%">
        <div class="modal-dialog" role="document" style="width: 1024px; max-width: 100% !important">
            <div class="modal-content" id="load_SendMail">
                <div class="modal-header">
                    <h5 class="modal-title" style="font-weight: bold; font-size: 15px">Bình luận tin tức</h5>
                    <button type="button" id="btnCloseTop" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" id="formblvb">
                    <form id="f-send">
                        <input type="hidden" name="idTinTuc" id="idTinTuc" value="2774" class="form-control" />
                        <div class="mb-3">
                            <label for="email">Nội dung bình luận <span class="required">(*)</span>:</label>
                            <textarea rows="3" class="form-control modal-input" name="NoiDung" id="NoiDung"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="pwd">Họ tên<span class="required">(*)</span>:</label>
                            <input type="text" name="NguoiGui modal-input" id="NguoiGui" placeholder="Nhập tên người gửi" value="" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="pwd">Số điện thoại:</label>
                            <input type="text" name="SoDienThoai modal-input" id="SoDienThoai" placeholder="Nhập số điện thoại" value="" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="pwd">Email<span class="required">(*)</span>:</label>
                            <input type="text" name="Email modal-input" id="Email" placeholder="Nhập email" value="" class="form-control" />
                        </div>
                        
                        <label for="maXacNhan">OTP </label>
                        <div class="mb-3 row" style="margin-left: 1px">

                            <div class="col-md-6 col-sm-12" style="padding-left: 0px;">
                                <input type="text" name="MaXacNhan modal-input" id="MaXacNhan" placeholder="Nhập mã OTP nhận được từ email" value="" class="form-control" />
                            </div>
                            <div class="col-md-6 col-sm-12">
                                <button type="button" class="btn btn-btn-success" id="BtnMaXacNhan2" style="color: #fff; background-color: #398439; border-color: #255625; margin-bottom: 15px;">Nhận mã OTP từ email</button>
                                <i class="fa fa-spinner fa-spin fa-lg  checkshowload2"></i><i class="fa fa-check fa-lg  checkshowtrue2"></i>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" id="btnSendmail">Gửi bình luận</button>
                            <button type="button" class="btn btn-default" id="btnCloseModal" data-dismiss="modal">Đóng</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <div class="modal " role="dialog" id="sendmailTo" style="width: 100%">
        <div class="modal-dialog" role="document" style="width: 1024px; max-width: 100% !important">
            <div class="modal-content" id="load_SendMailTo">
                <div class="modal-header">
                    <h5 class="modal-title" style="font-weight: bold; font-size: 15px; margin: unset">Gửi email</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" id="btnCloseTopEmail">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" id="formblvbTo">
                    <form id="f-sendTo">
                        
                        <input type="hidden" name="link" id="link" value="https://nrsd.mae.gov.vn/cong-bo-bao-cao-sieu-du-lieu-vien-tham-2025-phuc-vu-quan-ly-giam-sat-va-phat-trien-ben-vung-2774.htm" />
                        <div class="mb-3">
                            <label for="email">Email người nhận<span class="required">(*)</span>:</label>
                            <input class="form-control" name="lmailto" id="lmailto" value="">
                        </div>
                        <div class="mb-3">
                            <label for="pwd">Tiêu đề <span class="required">(*)</span>:</label>
                            <input type="text" class="form-control" name="subject" id="subject">
                        </div>
                        <div class="mb-3">
                            <label for="pwd">Nội dung mail <span class="required">(*)</span>:</label>
                            <textarea rows="3" class="form-control" name="content" id="content"></textarea>
                        </div>
                        
                        
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" id="btnSendmailTo">Gửi email</button>
                            <button type="button" class="btn btn-default" id="btnCloseModalTo" data-dismiss="modal">Đóng</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#copyButton').click(function (e) {
            e.preventDefault();
            // Lấy nội dung của đoạn văn bản
            var textlink = $("#link").val();
            var textContent = textlink;
            // Tạo một thẻ textarea tạm thời để sao chép
            var tempTextarea = $('<textarea>');
            tempTextarea.val(textContent);
            // Thêm thẻ vào body và chọn nó
            $('body').append(tempTextarea);
            tempTextarea.select();
            // Thực hiện lệnh sao chép
            document.execCommand('copy');
            // Xóa thẻ textarea tạm thời
            tempTextarea.remove();
        });
        $(".checkshowload2").hide();
        $(".checkshowtrue2").hide();
        var keycheck = "";
        $('#gop-y-tin-tuc').click(function () {
            $('#sendmail').modal('show');
            var newDiv = $("<div class='modal-backdrop2'></div>");
            $("#DeltaPlaceHolderUtilityContent").append(newDiv);
        });
        $('#btnCloseModal').click(function () {
            $('#sendmail').modal('hide');
        });
        $('#btnCloseTop').click(function () {
            $('#sendmail').modal('hide');
        });
        $('#btnCloseModalTo').click(function () {
            $('#sendmailTo').modal('hide');
        });
        $('#btnCloseTopEmail').click(function () {
            $('#sendmailTo').modal('hide');
        });
        $('#senmail').click(function () {
            $('#sendmailTo').modal('show');
        });
        $("#BtnMaXacNhan2").click(function () {
            var Email = $("#Email").val();
            var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            $(".checkshowload2").show();
            $(".checkshowtrue2").hide();
            if (Email != null && Email != "" && emailRegex.test(Email)) {
                //$.post("/API/TinTuc/SENDMAILOTP_BinhLuan", "&Email=" + Email, function (result) {
                $.post("/SMPT_Publishing_UC/KhaiThacCucVienTham/TinTuc/hActionTinTucBaiViet.ashx?action=SENDMAILOTP_BINHLUAN", "&Email=" + Email, function (result) {
                    $(".checkshowload2").hide();
                    $(".checkshowtrue2").show();
                    if (result.Source != null) {
                        keycheck = result.Source;
                    } else {
                        alert("Hệ thống đang cập nhật bạn vui lòng thử lại sau !");
                    }
                });
            } else {
                $(".checkshowload2").hide();
                alert("Email không hợp lệ hoặc không được để trống!");
            }

            //  $("#CaptchaImage").attr("src", UrlImageChaptCha + Math.random());
            //  $('#Captcha').val('');
        });
        $('#btnSendmailTo').click(function () {
            if (!validateFormBV()) {
                return;
            }
            var formData = {
                NoiDung: $('#content').val(),
                Title: $('#subject').val(),
                Email: $('#lmailto').val(),
                link: $('#link').val(),
                Key: keycheck,
            };
            $.ajax({
                url: '/SMPT_Publishing_UC/KhaiThacCucVienTham/TinTuc/hActionTinTucBaiViet.ashx?action=BINHLUANBV',
                method: 'POST',
                data: formData,
                success: function (response) {
                    if (response.Message == "Đã gửi mail thành công") {
                        //$('.modal-input').val('');
                        $('#content, #MaXacNhanTo,#subject').val('');
                        $('#sendmailTo').modal('hide');
                        alert('Email đã được gửi thành công đến người dùng.');

                    }
                    else {
                        alert(response.Message);
                    }

                },
                error: function (error) {
                    console.error('Lỗi khi gửi email:', error);
                    alert('An error occurred while sending the email. Please try again.');
                }
            });
        });
        $('#zoom-out').on('click', function () {
            setFontSize(factor);
        });
        $('#zoom-in').on('click', function () {

            setFontSize(1 / factor);
        });
        $('#btnSendmail').click(function () {
            if (!validateForm()) {
                return;
            }
            var formData = {
                NoiDung: $('#NoiDung').val(),
                Title: $('#NoiDung').val(),
                NguoiGui: $('#NguoiGui').val(),
                SoDienThoai: $('#SoDienThoai').val(),
                Email: $('#Email').val(),
                MaXacNhan: $('#MaXacNhan').val(),
                idTinTuc: $('#idTinTuc').val(),
                Key: keycheck,
            };
            $.ajax({
                url: '/SMPT_Publishing_UC/KhaiThacCucVienTham/TinTuc/hActionTinTucBaiViet.ashx?action=BINHLUAN',
                method: 'POST',
                data: formData,
                success: function (response) {
                    if (response.Message == "Gửi bình luận thành công") {
                        //$('.modal-input').val('');
                        $('#NoiDung, #MaXacNhan').val('');
                        $('#sendmail').modal('hide');
                        alert('Email đã được gửi thành công');

                    }
                    else {
                        alert(response.Message);
                    }

                },
                error: function (error) {
                    console.error('Lỗi khi gửi email:', error);
                    alert('Đã xảy ra lỗi khi gửi email. Vui lòng thử lại.');
                }
            });
        });
        // load ajax lấy nội dụng từ file urlContent đổ vào thẻ html container
        function loadAjaxContent(urlContent, container, data) {

            try {
                var $container = $(container);
                if (typeof data == undefined)
                    data = {};
                $(container).html("<img class='waitingIMG' src='/Content/images/loading.gif' />");
                var dfd = $.Deferred();
                $container.load(urlContent, data, function (response, status, xhr) {
                    if (status == "error") {
                        var msg = "Đã có lỗi xảy ra khi tải trang, vui lòng kiểm tra lại kết nối internet" + xhr.status + " " + xhr.statusText;
                        $container.html(msg);
                    }
                    return dfd.resolve();
                });
                return dfd.promise();
            } catch (e) {
                $container.html(e.message);
            }

        }

    })
    function validateForm() {
        var NoiDungValue = $('#NoiDung').val().trim();
        var NguoiGuiValue = $('#NguoiGui').val().trim();
        var emailValue = $('#Email').val().trim();
        var SoDienThoaiValue = $('#SoDienThoai').val().trim();

        // Kiểm tra trường NoiDung
        if (NoiDungValue === '') {
            alert('Nội dung không được để trống!');
            return false;
        }
        // Kiểm tra trường NoiDung
        if (NguoiGuiValue === '') {
            alert('Họ tên không được để trống!');
            return false;
        }
        // Kiểm tra trường SoDienThoai
        if (SoDienThoaiValue !== '') {
            var phoneRegex = /^\d{10}$/;
            if (!phoneRegex.test(SoDienThoaiValue)) {
                alert('Số điện thoại không hợp lệ!');
                return false;
            }
        }
        // Kiểm tra trường email
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (emailValue === '' || !emailRegex.test(emailValue)) {
            alert('Email không hợp lệ hoặc không được để trống!');
            return false;
        }


        // Nếu không có lỗi, trả về true
        return true;
    }
    function validateFormBV() {
        var NoiDungValue = $('#content').val().trim();
        var NguoiGuiValue = $('#subject').val().trim();
        var emailValue = $('#lmailto').val().trim();

        // Kiểm tra trường NoiDung
        if (NoiDungValue === '') {
            alert('Content cannot be empty!');
            return false;
        }
        // Kiểm tra trường NoiDung
        if (NguoiGuiValue === '') {
            alert('Subject cannot be empty!');
            return false;
        }
        // Kiểm tra trường email
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (emailValue === '' || !emailRegex.test(emailValue)) {
            alert('Invalid email or email cannot be empty!');
            return false;
        }

        // Nếu không có lỗi, trả về true
        return true;
    }
    function getFontSize(el) {

        var fs = $(el).css('font-size');
        if (!el.originalFontSize) el.originalFontSize = fs; //set dynamic property for later reset  

        return parseFloat(fs);
    }
    var section;
    var factor = 0.9;
    function setFontSize(fact) {

        if (section == null)
            section = $('#News-content').find('*')
                .filter(
                    function () {
                        return $(this).clone()
                            .children()
                            .remove()
                            .end()
                            .text().trim().length > 0;
                    }); //filter -> exclude all elements without text

        section.each(function () {
            var newsize = fact ? getFontSize(this) * fact : this.originalFontSize;
            var size = getFontSize(this) * fact;
            var lineheight = 1.4 * fact;
            console.log("newsize: " + newsize);
            console.log("lineheight: " + lineheight);
            if (newsize && size < 65) {
                $(this).css('font-size', newsize);
                $(this).css('line-height', lineheight);
            }
            // fix tăng cỡ chữ
        });

    }
</script>

