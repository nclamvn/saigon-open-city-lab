<style>
    .vmenu-box div.position-relative {
        padding-bottom: 0;
    }

    @media (max-width:500px) and (min-width:300px) {
        .dichvubanner {
            display: none !important;
        }
    }

    .main_menu > .header-nav-main > li.has-children > .nav-dropdown > li.menu-item:hover > ul.nav-dropdown2 {
        padding-left: 0px;
        border-right: 1px solid #ffffff;
        border-left: 1px solid #ffffff;
        border-bottom: 1px solid #ffffff;
        /* border-radius: 16px; */
        display: block;
        left: unset;
        right: -92%;
    }

    .main_menu > .header-nav-main > li.has-children > .nav-dropdown > li.menu-item > ul {
        position: absolute;
        width: 100%;
        top: 0;
        left: -100%;
        background: #0075c5;
        display: none;
    }

    .main_menu > .header-nav-main > li.has-children > .nav-dropdown a {
        color: white !important;
    }

    .main_menu > .header-nav-main > .has-children:hover ul.nav-dropdown li:hover {
        background-color: #38a3eb;
    }
    /* Menu cấp 3 - đảm bảo hiển thị đúng */
    .main_menu > .header-nav-main > li.has-children > .nav-dropdown > li.menu-item > ul.nav-dropdown2 > li.menu-item:hover > ul.nav-dropdown3 {
        display: block;
        top: 0;
        left: 100%;
        position: absolute;
        background: #0075c5;
        max-width: 235px;
        z-index: 1000;
        border: 1px solid #ffffff;
        padding-left: 0px;
    }

    /* ===== MENU CẤP 4 ===== */
    .main_menu > .header-nav-main > li.has-children > .nav-dropdown > li.menu-item > ul.nav-dropdown2 > li.menu-item:hover > ul.nav-dropdown3 {
        display: block;
        top: 0;
        left: 100%;
        position: absolute;
        background: #0075c5;
        max-width: 235px;
        z-index: 1000;
        border: 1px solid #ffffff;
        padding-left: 0;
    }

    /* Ẩn mặc định */
    .nav-dropdown3 {
        display: none;
        position: absolute;
        top: 0;
        left: 100%;
        background: #0075c5;
        max-width: 235px;
        width: 100%;
        z-index: 999;
        border: 1px solid #ffffff;
    }

    /* Hiển thị khi hover */
    .nav-dropdown2 > li.menu-item:hover > .nav-dropdown3 {
        display: block;
    }

    /* Kiểu chữ, padding */
    .nav-dropdown3 a,
    .nav-dropdown2 a {
        font-size: 14px;
        font-weight: 400;
        line-height: 1.4;
        padding: 4px 16px 1px 16px;
        color: #fff !important;
        display: block;
        white-space: normal; /* ✅ Cho phép xuống dòng nếu dài */
        word-break: break-word; /* ✅ Ngắt từ khi quá dài */
    }

    /* Các item li */
    .nav-dropdown3 li,
    .nav-dropdown2 li {
        padding: 0;
        margin: 0;
        list-style: none;
        min-height: 36px;
    }

        /* Hover màu nền */
        .nav-dropdown3 li:hover {
            background-color: #38a3eb;
        }

    /* Cần thiết để menu cấp 4 căn đúng */
    .nav-dropdown2 > li.menu-item {
        position: relative;
    }
