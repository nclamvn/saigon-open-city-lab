<script>
    $(document).ready(function () {
        var url = window.location.origin;
        var imageUrl = "/Content/publishing_home/imgCongChinh/bannernen.png";
        
        imageUrl = "https://media-nrsd.mae.gov.vn/Image/af380f99-d336-eb30-7e71-dc5b88d808ec/2025/9/3/pngtree-the-illustration-shows-a-satellite-orbiting-earth-image_2889405_107d0b96a0.jpg";
        $(".vbanner ").css("background-image", "url(" + imageUrl + ")");
        

        var widthtb = $("#ms-designer-ribbon").width();
        if (widthtb < 500) {
            var imageUrl = "/Content/publishing_home/imgCucVienTham/banner.png";
 
            imageUrl = "https://media-nrsd.mae.gov.vn/Image/portal_smadmin/2024/10/16/Banner_mobile_500x125_cucviễn-thám-quốc-gia_652b70e0f1.jpg";
            $("div.bannerweb img").css("display", "none");

            $(".vbanner ").css("background-image", "url(" + imageUrl + ")");
            $(".vbanner ").css("background-size", "100% 100%");
            $("#httntext").css("top", "96px");
            $("#httntext").css("left", "28.1%");
        }

        
        $("#TabNew li.title-header-info").click(function () {

            $("#TabNew .active").removeClass("active");
            $(".tab-content .active").removeClass("active");
            $(this).addClass("active");

            let idaction = $(this).find("a").attr("href");
            $(idaction).addClass("active");
            $(idaction).addClass("in");
        })
        $(".danhmuc-box").css("display", "none");
        $(".danhmucbtn").click(function () {
            var ktra = $(".danhmucbtn").hasClass("activeulv");
            if (ktra) {
                $(".danhmucbtn").removeClass("activeulv");
                $(".danhmuc-box").slideUp();
            } else {
                $(".danhmucbtn").addClass("activeulv");
                $(".danhmuc-box").slideToggle();
            }
        });
        setInterval(updateClock, 1000);
        $("#mobisearch").on("click", function () {

            var ktra = $(".searchmobi").hasClass("activesearch");
            if (ktra) {
                $(".searchmobi").removeClass("activesearch");
                $(".overlay_menu").removeClass("active");
                $(".searchmobi").css("display", "none");

                $(".margin-right").css("border-radius", "5px");

            } else {
                $(".searchmobi").addClass("activesearch");
                $(".overlay_menu").addClass("active");
                $(".searchmobi").css("display", "block");
                $(".margin-right").css("border-radius", "15px");
            }
        });
        $("#mobisearch1").on("click", function () {
            var keyword = $("#searchinputmobi").val();
            window.location.href = '/tim-kiem.htm?keyword=' + keyword;
        });
        $("#mobimenu").on("click", function () {

            var ktra = $("#navbarCollapse").hasClass("show");
            if (ktra) {
                $("#navbarCollapse").removeClass("show");
                $(".overlay_menu").removeClass("active");
                $("nav.custom-menu-mobile").css("display", "none");

            } else {
                $("nav.custom-menu-mobile").css("display", "block");
                $("#navbarCollapse").addClass("show");
                $(".overlay_menu").addClass("active");
            }
        });
        $(".overlay_menu").on("click", function () {

            var ktra = $(".overlay_menu").hasClass("active");
            if (ktra) {
                $(".searchmobi").removeClass("activesearch");
                $("#navbarCollapse").removeClass("show");
                $(".overlay_menu").removeClass("active");
                $(".searchmobi").css("display", "none");

            } else {
                $(".searchmobi").addClass("activesearch");
                $(".overlay_menu").addClass("active");
                $(".searchmobi").css("display", "block");
            }
        });
        $(".mobile_menu .navbar-toggler").on("click", function () {
            var ktra = $(".overlay_menu").hasClass("active");
            if (ktra) {
                $(".searchmobi").removeClass("activesearch");
                $("#navbarCollapse").removeClass("show");
                $(".overlay_menu").removeClass("active");
                $(".searchmobi").css("display", "none");

            } else {
                $(".searchmobi").addClass("activesearch");
                $(".overlay_menu").addClass("active");
                $(".searchmobi").css("display", "block");
            }
        });
        $('.mobile_menu .has-child .fa-caret-down').click(function () {
            var idthis = $(this).data("id");
            $(`#nav-mobile-sub${idthis}`).slideToggle();
            $(this).toggleClass('rotate_180');
        });

    });

    function updateClock() {
        const now = new Date();
        var currentDay = now.getDay();
        var currentDate = now.getDate();
        var currentMon = now.getMonth() + 1;
        var currentYr = now.getFullYear();
        currentDate = (currentDate < 10 ? "0" : "") + currentDate;
        currentMon = (currentMon < 10 ? "0" : "") + currentMon;
        const daysOfWeek = ['<strong>Chủ nhật</strong>', '<strong>Thứ hai</strong>', '<strong>Thứ ba</strong>', '<strong>Thứ tư</strong>', '<strong>Thứ năm</strong>', '<strong>Thứ sáu</strong>', '<strong>Thứ bảy</strong>'];
        const dayOfWeekString = daysOfWeek[currentDay];

        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');


        const timeString = `${dayOfWeekString}, ${currentDate}/${currentMon}/${currentYr} , ${hours}:${minutes}`;
        $("#date-info").html(timeString);
    }
</script>

</div>
                            
