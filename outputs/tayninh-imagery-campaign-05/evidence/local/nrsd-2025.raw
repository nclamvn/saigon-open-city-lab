            <div class="panel-title py-1"><a href="/chuyen-muc/tin-hoat-dong-60.htm" title="Tin hoạt động" rel="dofollow"><span style="color: rgb(8, 28, 54);">Xem thêm</span></a></div>




        </div>
    </div>
    <div class="col-xxl-12 mt-2 tintucimg">
        
        <div class="row mt-2 vien-giua-cac-tin">
            <div class="col-lg-3 col-xl-3 col-xxl-3 ps-0 col-3">
                
                <img class="w-100" src="https://media-nrsd.mae.gov.vn/Image/91e7814b-06d9-b990-ad84-400855dfb6ad/2026/9/7/6-vung-kinh-te_b25ae4d7cf_e264f3ed5e.jpg" alt="Tổ chức lại không gian phát triển quốc gia, khơi thông nguồn lực cho giai đoạn phát triển mới" loading="lazy">
                
            </div>
            <div class="col-9 col-sm-7 col-md-9 col-xxl-9">
