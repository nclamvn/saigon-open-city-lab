ogtvt.csv", "package_id": "a4ef73b3-2834-4a19-9d19-da44bafe06d8", "position": 0, "resource_id": "4abd0c86-4a1e-4e7b-8144-d82b47de6f76", "resource_type": null, "set_url_type": false, "size": 5212, "state": "active", "task_created": "2024-12-25 03:32:53.433850", "url": "https://data.tayninh.gov.vn/dataset/a4ef73b3-2834-4a19-9d19-da44bafe06d8/resource/4abd0c86-4a1e-4e7b-8144-d82b47de6f76/download/danhmucdulieusogtvt.csv", "url_type": "upload"}], "tags": [], "extras": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}, {"author": "", "author_email": "", "creator_user_id": "ac05cc87-9b62-4e96-a19f-e6c8d28a2f9c", "id": "4cf64c2a-cc63-4d07-afd9-4b7defaa72a8", "isopen": false, "license_id": "", "license_title": "", "maintainer": "", "maintainer_email": "", "metadata_created": "2024-12-17T09:55:53.226934", "metadata_modified": "2024-12-25T03:53:11.688249", "name": "danh-m-c-thu-c-thu-c-t-du-c-li-u-gia-thu-c-du-c-c-p-phep-luu-hanh", "notes": "D\u1eef li\u1ec7u cung c\u1ea5p danh s\u00e1ch t\u1ea5t c\u1ea3 c\u00e1c thu\u1ed1c, thu\u1ed1c t\u1eeb d\u01b0\u1ee3c li\u1ec7u, gi\u00e1 thu\u1ed1c thanh to\u00e1n b\u1ea3o hi\u1ec3m y t\u1ebf tr\u00ean \u0111\u1ecba b\u00e0n t\u1ec9nh gi\u00fap cho c\u00e1c c\u00e1 nh\u00e2n d\u1ec5 d\u00e0ng t\u00ecm ki\u1ebfm trong vi\u1ec7c thanh to\u00e1n b\u1ea3o hi\u1ec3m y t\u1ebf t\u1ea1i t\u1eebng c\u00f3 s\u1edf y t\u1ebf.\r\nD\u1eef li\u1ec7u bao g\u1ed3m th\u00f4ng tin v\u1ec1: t\u00ean ho\u1ea1t ch\u1ea5t, n\u1ed3ng \u0111\u1ed9 h\u00e0m l\u01b0\u1ee3ng, s\u1ed1 \u0111\u0103ng k\u00fd ho\u1eb7c gi\u1ea5y ph\u00e9p nh\u1eadp kh\u1ea9u, \u0111\u01b0\u1eddng d\u00f9ng, d\u1ea1ng b\u00e0o ch\u1ebf, t\u00ean c\u01a1 s\u1edf s\u1ea3n xu\u1ea5t, n\u01b0\u1edbc s\u1ea3n xu\u1ea5t, quy c\u00e1ch \u0111\u00f3ng g\u00f3i, \u0111\u01a1n v\u1ecb t\u00ednh, \u0111\u01a1n gi\u00e1, nh\u00f3m thu\u1ed1c, t\u00ean c\u01a1 s\u1edf y t\u1ebf.\r\n", "num_resources": 3, "num_tags": 0, "organization": {"id": "17fee22d-40f8-4dbf-91