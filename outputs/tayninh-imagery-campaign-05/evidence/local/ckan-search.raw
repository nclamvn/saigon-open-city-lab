csv", "mimetype_inner": null, "name": "BienDongBanDo.csv", "original_url": "https://data.longan.gov.vn/dataset/45254d36-7399-4554-a2a5-e518e3e20059/resource/4a0121c2-ccf3-4355-911f-3758a055401d/download/biendongbando.csv", "package_id": "45254d36-7399-4554-a2a5-e518e3e20059", "position": 0, "resource_id": "4a0121c2-ccf3-4355-911f-3758a055401d", "resource_type": null, "set_url_type": false, "size": 154870, "state": "active", "task_created": "2024-12-25 03:32:54.849981", "url": "https://data.tayninh.gov.vn/dataset/45254d36-7399-4554-a2a5-e518e3e20059/resource/4a0121c2-ccf3-4355-911f-3758a055401d/download/biendongbando.csv", "url_type": "upload"}], "tags": [], "extras": [], "relationships_as_subject": [], "relationships_as_object": []}, {"author": "", "author_email": "", "creator_user_id": "ac05cc87-9b62-4e96-a19f-e6c8d28a2f9c", "id": "4af28825-2946-4992-8881-ae9ff6bdba89", "isopen": true, "license_id": "cc-by", "license_title": "Gi\u1ea5y ph\u00e9p b\u1ea3n quy\u1ec1n m\u1edf", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": "", "maintainer_email": "", "metadata_created": "2022-07-08T10:54:12.747240", "metadata_modified": "2025-09-03T07:02:09.215895", "name": "d-li-u-tr-m-bts", "notes": "D\u1eef li\u1ec7u tr\u1ea1m BTS cung c\u1ea5p th\u00f4ng tin v\u00e0 chi ti\u1ebft hi\u1ec7n tr\u1ea1ng c\u00e1c tr\u1ea1m BTS hi\u1ec7n c\u00f3 tr\u00ean \u0111\u1ecba b\u00e0n t\u1ec9nh Long An.                                                      \r\nC\u00e1c danh s\u00e1ch tr\u1ea1m BTS do doanh nghi\u1ec7p cung c\u1ea5p:                   \r\n1. Danh s\u00e1ch d\u1eef li\u1ec7u tr\u1ea1m BTS t\u1ed5ng h\u1ee3p tr\u00ean \u0111\u1ecba b\u00e0n t\u1ec9nh Long An                                                                                                                                                                                                                                                                                \r\n2. Danh s\u00e1ch tr\u1ea1m BTS thi c\u00f4ng v\u00e0 l\u1eafp \u0111\u1eb7t b\u1edfi C\u00f4ng ty TNHH C\u00f4ng ngh\u1ec7 th\u00f4ng tin v\u00e0 truy\u1ec1n th\u00f4ng Gtel                                                                         \r\n3. Danh s\u00e1ch tr\u1ea1m BTS thi c\u00f4ng v\u00e0 l\u1eafp \u0111\u1eb7t b\u1edfi doanh nghi\u1ec7p Vi\u1ec5n th\u00f4ng Mobifone                                                                                                          \r\n4. Danh s\u00e1ch tr\u1ea1m BTS thi c\u00f4ng v\u00e0 l\u1eafp \u0111\u1eb7t b\u1edfi D\u1ecbch v\u1ee5 Vi\u1ec5n th\u00f4ng Viettel                                                                                                                           \r\n5. Danh s\u00e1ch tr\u1ea1m BTS thi c\u00f4ng v\u00e0 l\u1eafp \u0111\u1eb7t b\u1edfi C\u00f4ng ty C\u1ed5 ph\u1ea7n Vi\u1ec5n th\u00f4ng Di \u0111\u1ed9ng Vietnamobile                                                                                 \r\n6. Danh s\u00e1ch tr\u1ea1m BTS thi c\u00f4ng v\u00e0 l\u1eafp \u0111\u1eb7t b\u1edfi D\u1ecbch v\u1ee5 Vi\u1ec5n th\u00f4ng VNPT", "num_resources": 6, "num_tags": 0, "organization": {"id": "cc716172-030b-4c62-9777-1ff9f2bd224d", "name": "skhcn", "title": "S\u1edf Khoa h\u1ecdc v\u00e0 C\u00f4ng ngh\u1ec7", "type": "organization", "description": "", "image_url": "2022-04-19-084406.326678kh-cn.jpg", "created": "2022-04-19T15:19:19.847380", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "cc716172-030b-4c62-9777-1ff9f2bd224d", "private": false, "state": "active", "title": "Danh s\u00e1ch d\u1eef li\u1ec7u tr\u1ea1m BTS tr\u00ean \u0111\u1ecba b\u00e0n t\u1ec9nh Long An", "type": "dataset", "url": "", "version": "", "resources": [{"cache_last_updated": null, "cache_url": null, "ckan_url": "https://data.longan.gov.vn", "created": "2022-07-08T10:54:37.464542", "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "description": "", "forma