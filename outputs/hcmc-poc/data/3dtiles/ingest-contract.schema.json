{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reality Patch Tile Sidecar",
  "type": "object",
  "required": ["tileId", "contentUri", "source", "license", "captureDate", "horizontalCrs", "verticalDatum", "quality"],
  "properties": {
    "tileId": {"type": "string", "pattern": "^rp-r[1-4]c[1-4]$"},
    "contentUri": {"type": "string", "pattern": "\\.glb$"},
    "source": {"type": "string"},
    "license": {"type": "string"},
    "captureDate": {"type": ["string", "null"], "format": "date"},
    "horizontalCrs": {"type": "string"},
    "verticalDatum": {"type": "string"},
    "quality": {
      "type": "object",
      "required": ["status", "positionAccuracyM", "textureGsdCm"],
      "properties": {
        "status": {"enum": ["unverified", "controlled", "surveyed"]},
        "positionAccuracyM": {"type": ["number", "null"], "minimum": 0},
        "textureGsdCm": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
